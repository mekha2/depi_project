      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traffic_http_request_duration_seconds_bucket{endpoint=\"/\"}[5m])))",
          "legendFormat": ""
